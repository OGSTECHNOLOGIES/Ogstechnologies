---
import academyImage from '../assets/IMG-20260210-WA0012.jpg';
---

<section id="academy" class="academy">
	<div class="container">
		<div class="section-header">
			<div class="badge">OGS Technologies Academy</div>
			<h2>Learn Life-Changing <span class="highlight">Tech Skills</span></h2>
			<p>Get practical training, mentorship, and real field experience to launch your tech career</p>
		</div>

		<div class="academy-content">
			<div class="academy-image">
				<img src={academyImage.src} alt="OGS Technologies Academy Students and Instructor" />
				<div class="image-overlay"></div>
			</div>

			<div class="academy-info">
				<h3>Transform Your Future</h3>
				<p class="intro">Join hundreds of students who have gained valuable technical skills and started successful careers in the energy and tech industry.</p>

				<div class="training-programs">
					<div class="program-item">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
						</svg>
						<span>Solar Installation Training</span>
					</div>
					<div class="program-item">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
						</svg>
						<span>Electrical Wiring Training</span>
					</div>
					<div class="program-item">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
						</svg>
						<span>CCTV Installation Training</span>
					</div>
					<div class="program-item">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
						</svg>
						<span>Energy Management</span>
					</div>
				</div>

				<div class="benefits">
					<h4>Why Choose OGS Academy?</h4>
					<div class="benefits-grid">
						<div class="benefit">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
							</svg>
							<div>
								<strong>Hands-on Training</strong>
								<p>Learn by doing with real equipment and projects</p>
							</div>
						</div>
						<div class="benefit">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
							</svg>
							<div>
								<strong>Career Ready</strong>
								<p>Work anywhere or start your own business</p>
							</div>
						</div>
						<div class="benefit">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
							</svg>
							<div>
								<strong>Expert Mentorship</strong>
								<p>Learn from experienced professionals</p>
							</div>
						</div>
						<div class="benefit">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
							</svg>
							<div>
								<strong>Build Confidence</strong>
								<p>Gain skills that empower you for life</p>
							</div>
						</div>
					</div>
				</div>

				<a href="#contact" class="btn btn-primary">Enroll Now</a>
			</div>
		</div>
	</div>
</section>

<style>
	.academy {
		padding: 6rem 2rem;
		background: linear-gradient(180deg, #f9fafb 0%, #ffffff 100%);
	}

	.container {
		max-width: 1200px;
		margin: 0 auto;
	}

	.section-header {
		text-align: center;
		margin-bottom: 4rem;
	}

	.badge {
		display: inline-block;
		padding: 0.5rem 1.5rem;
		background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);
		color: white;
		border-radius: 50px;
		font-weight: 600;
		font-size: 0.9rem;
		margin-bottom: 1rem;
		letter-spacing: 0.5px;
	}

	.section-header h2 {
		font-size: 2.75rem;
		font-weight: 800;
		color: #000;
		margin: 0 0 1rem;
		letter-spacing: -0.5px;
	}

	.section-header h2 .highlight {
		color: #dc2626;
	}

	.section-header p {
		font-size: 1.2rem;
		color: #666;
		margin: 0;
		max-width: 700px;
		margin: 0 auto;
	}

	.academy-content {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 4rem;
		align-items: start;
	}

	.academy-image {
		position: relative;
		border-radius: 20px;
		overflow: hidden;
		box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
	}

	.academy-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.image-overlay {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: linear-gradient(180deg, transparent 0%, rgba(0, 0, 0, 0.1) 100%);
	}

	.academy-info h3 {
		font-size: 2rem;
		font-weight: 700;
		color: #000;
		margin: 0 0 1rem;
	}

	.intro {
		font-size: 1.1rem;
		color: #666;
		line-height: 1.7;
		margin-bottom: 2rem;
	}

	.training-programs {
		display: grid;
		gap: 1rem;
		margin-bottom: 2.5rem;
	}

	.program-item {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 1rem;
		background: white;
		border-radius: 10px;
		border-left: 3px solid #dc2626;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
	}

	.program-item svg {
		width: 24px;
		height: 24px;
		color: #dc2626;
		flex-shrink: 0;
	}

	.program-item span {
		font-weight: 600;
		color: #000;
	}

	.benefits h4 {
		font-size: 1.5rem;
		font-weight: 700;
		color: #000;
		margin: 0 0 1.5rem;
	}

	.benefits-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.5rem;
		margin-bottom: 2.5rem;
	}

	.benefit {
		display: flex;
		gap: 1rem;
		align-items: start;
	}

	.benefit svg {
		width: 28px;
		height: 28px;
		color: #dc2626;
		flex-shrink: 0;
	}

	.benefit strong {
		display: block;
		font-size: 1.1rem;
		color: #000;
		margin-bottom: 0.25rem;
	}

	.benefit p {
		font-size: 0.95rem;
		color: #666;
		margin: 0;
		line-height: 1.4;
	}

	.btn {
		padding: 1rem 2.5rem;
		font-size: 1.1rem;
		font-weight: 600;
		text-decoration: none;
		border-radius: 8px;
		transition: all 0.3s ease;
		display: inline-block;
	}

	.btn-primary {
		background: #dc2626;
		color: white;
		box-shadow: 0 4px 20px rgba(220, 38, 38, 0.4);
	}

	.btn-primary:hover {
		background: #b91c1c;
		transform: translateY(-2px);
		box-shadow: 0 6px 30px rgba(220, 38, 38, 0.6);
	}

	@media (max-width: 968px) {
		.academy-content {
			grid-template-columns: 1fr;
			gap: 3rem;
		}

		.benefits-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 768px) {
		.academy {
			padding: 4rem 1.5rem;
		}

		.section-header h2 {
			font-size: 2rem;
		}

		.section-header p {
			font-size: 1rem;
		}

		.academy-info h3 {
			font-size: 1.5rem;
		}

		.benefits h4 {
			font-size: 1.25rem;
		}
	}
</style>
